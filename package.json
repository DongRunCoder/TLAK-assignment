{
  "name": "anna-mini-notes",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.22.2 || ^24.15.0 || >=26.0.0" },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "build:watch": "vite build --watch",
    "dev": "node scripts/dev.mjs",
    "dev:preview": "node scripts/preview.mjs",
    "dev:real": "node scripts/dev-real.mjs",
    "dev:harness": "node scripts/anna.mjs dev --no-llm --storage legacy --bundle ./bundle",
    "validate": "node scripts/anna.mjs validate --strict --bundle ./bundle",
    "doctor": "node scripts/doctor.mjs",
    "check:contracts": "node scripts/check-contracts.mjs",
    "test": "vitest run",
    "test:preview": "node --test tests/preview/*.test.mjs",
    "test:session": "node scripts/test-session-recovery.mjs",
    "test:go": "node scripts/go.mjs test ./...",
    "test:security": "node --test tests/security/*.test.mjs",
    "test:protocol": "node scripts/build-tool.mjs --test",
    "test:sampling": "node scripts/test-sampling.mjs",
    "test:harness": "node scripts/test-harness.mjs",
    "verify:harness": "node scripts/verify-harness.mjs",
    "test:packaging": "node --test tests/packaging/*.test.mjs",
    "package:native": "node scripts/package-native.mjs",
    "smoke:archive": "node scripts/smoke-archive.mjs"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@anna-ai/cli": "0.1.61",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "tar": "7.5.22",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
